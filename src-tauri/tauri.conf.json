{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dungeon Books",
  "version": "0.3.3",
  "identifier": "com.dungeonbooks.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dungeon Books",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFNzA4RDNDRkNCOTc4RjIKUldUeWVMbjhQSTF3TG1vSFZzaG1vSnhVYUxVSFpIK0FOVHkzc01uaGkxaDJuTDYzamU2N1dXYksK",
      "endpoints": ["https://github.com/ImDeadWeight/Dungeonbooks/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
