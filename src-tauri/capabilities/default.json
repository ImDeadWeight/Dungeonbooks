{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: read/write the app's own JSON data under AppData; read (never write) the separate Encounters and Lorekeeper apps' data to copy it on first start; custom title bar controls.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "fs:default",
    "dialog:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$DATA/com.encounters.app/data/*.json" }, { "path": "$DATA/com.lorekeeper.app/data/*.json" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$DATA/com.encounters.app/data/*.json" }, { "path": "$DATA/com.lorekeeper.app/data/*.json" }]
    }
  ]
}
